+#[tokio::test]
+async fn tagged_openai_response_exposes_identity_of_each_provider_frame() {
+    let (transport, peer) = FakeTransport::new();
+    let codec = OpenAiRealtimeCodec::new(OpenAiRealtimeConfig {
+        manual_turns: true,
+        ..Default::default()
+    });
+    let (session, driver) =
+        RealtimeSession::connect(&transport, request(), Arc::new(codec), limits(4, 4096))
+            .await
+            .unwrap();
+    let (control, events) = session.into_parts();
+    assert!(control.supports_response_attribution());
+    assert!(matches!(
+        control.send_with_response_tag(
+            realtime::RealtimeInput::Text("hello".into()),
+            "token-1",
+            Some(7)
+        ),
+        Err(RealtimeError::InvalidInput { .. })
+    ));
+    let mut events = events.into_ordered();
+    control
+        .send_with_response_tag(
+            realtime::RealtimeInput::Text("hello".into()),
+            "token-1",
+            Some(7),
+        )
+        .unwrap();
+    let task = tokio::spawn(driver.run());
+    assert_eq!(
+        events.next().await,
+        Some(RealtimeOrderedEvent::InputSent { id: 7 })
+    );
+    {
+        let sent = peer.sent.lock().unwrap();
+        let RealtimeFrame::Text(frame) = &sent[2] else {
+            panic!("response.create must be JSON text");
+        };
+        let request: serde_json::Value = serde_json::from_slice(frame).unwrap();
+        assert_eq!(request["type"], "response.create");
+        assert_eq!(request["response"]["metadata"]["lingxi_request"], "token-1");
+    }
+    for frame in [
+        serde_json::json!({"type":"response.created","response":{"id":"response-1","metadata":{"lingxi_request":"token-1"}}}),
+        serde_json::json!({"type":"response.output_item.done","response_id":"response-1","item":{"type":"function_call","call_id":"call-1","name":"lookup","arguments":"{}"}}),
+    ] {
+        peer.incoming
+            .unbounded_send(Ok(RealtimeFrame::text(frame.to_string())))
+            .unwrap();
+    }
+    assert!(matches!(
+        events.next().await,
+        Some(RealtimeOrderedEvent::AttributedProvider {
+            event: RealtimeEvent::TurnStarted { .. },
+            origin,
+        }) if origin.response_id == "response-1" && origin.request_tag.as_deref() == Some("token-1")
+    ));
+    assert!(matches!(
+        events.next().await,
+        Some(RealtimeOrderedEvent::AttributedProvider {
+            event: RealtimeEvent::ProviderEvent { .. },
+            ..
+        })
+    ));
+    assert!(matches!(
+        events.next().await,
+        Some(RealtimeOrderedEvent::AttributedProvider {
+            event: RealtimeEvent::ToolCall { .. }, origin,
+        }) if origin.response_id == "response-1" && origin.request_tag.is_none()
+    ));
+    assert!(matches!(
+        events.next().await,
+        Some(RealtimeOrderedEvent::AttributedProvider {
+            event: RealtimeEvent::ProviderEvent { .. },
+            ..
+        })
+    ));
+    control.abort(RealtimeClose::normal("done")).await.unwrap();
+    task.await.unwrap().unwrap();
+}
+
+#[test]
+fn response_tagging_refuses_automatic_openai_and_other_inputs() {
+    let codec = OpenAiRealtimeCodec::default();
+    assert!(!codec.supports_response_attribution());
+    assert!(codec
+        .encode_with_response_tag(&realtime::RealtimeInput::Text("hello".into()), "tag")
+        .is_err());
+    let codec = OpenAiRealtimeCodec::new(OpenAiRealtimeConfig {
+        manual_turns: true,
+        ..Default::default()
+    });
+    assert!(codec
+        .encode_with_response_tag(&realtime::RealtimeInput::CommitAudio, "tag")
+        .is_err());
+    assert!(codec
+        .encode_with_response_tag(&realtime::RealtimeInput::ContinueResponse, "")
+        .is_err());
+    let frames = codec
+        .encode_with_response_tag(&realtime::RealtimeInput::ContinueResponse, "tag-2")
+        .unwrap();
+    let RealtimeFrame::Text(frame) = &frames[0] else {
+        panic!("response.create must be JSON text");
+    };
+    let request: serde_json::Value = serde_json::from_slice(frame).unwrap();
+    assert_eq!(request["response"]["metadata"]["lingxi_request"], "tag-2");
+}
